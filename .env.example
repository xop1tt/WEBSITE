# Локально: cp .env.example .env.local (читается `npm run dev`).
# Для docker compose: cp .env.example .env — оттуда compose берёт
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME как build arg; API_BASE_URL в контейнере
# задаёт сам compose.yaml (http://api:8000).

# Базовый URL backend API (TELEGRAM-BOT/src/flamenco_bot/api). Запросы идут с сервера
# Next.js, а не из браузера — эта переменная не должна начинаться с
# NEXT_PUBLIC_, иначе попадёт в клиентский бандл.
API_BASE_URL=http://127.0.0.1:8000

# Общий секрет сайта и backend (FRONTEND_PROXY_SECRET на backend, то же
# значение, не короче 32 символов). Нужен на Netlify: сервер сайта передаёт
# backend'у IP посетителя, и rate limit входа считает попытки по посетителю.
# Только сервер — без NEXT_PUBLIC_. Для docker compose и `npm run dev` не нужен.
FRONTEND_PROXY_SECRET=

# Публичный @username Telegram-бота: ссылки на бота на главной, в контактах и
# кабинете. Не секрет (виден всем в Telegram), поэтому NEXT_PUBLIC_ — доступен
# в браузере. Вход через Telegram идёт ссылкой на бота (t.me/<бот>?start=…) и
# привязки домена в @BotFather не требует.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=miradastu_bot

# Часовой пояс студии для отображения времени занятий. Должен совпадать со
# STUDIO_TIMEZONE backend'а (по умолчанию в обоих — Europe/Moscow).
STUDIO_TIMEZONE=Europe/Moscow

# HTTPS в production (сервис caddy в compose.yaml, deploy/Caddyfile):
# публичный домен сайта — на него Caddy сам выпустит сертификат Let's Encrypt
# (DNS домена должен указывать на сервер, порты 80 и 443 открыты) — и email
# для уведомлений Let's Encrypt. Для `npm run dev` не нужны.
SITE_DOMAIN=
ACME_EMAIL=

# Технические работы (src/proxy.ts): адрес самого сайта, с которого proxy
# берёт HTML страницы /maintenance для ответа 503. Пусто — origin запроса
# (подходит для Netlify и `npm run dev`); в Docker задаёт compose.yaml.
SITE_INTERNAL_ORIGIN=
